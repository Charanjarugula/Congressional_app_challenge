root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.swift]
indent_size = 4

[*.md]
indent_size = unset
trim_trailing_whitespace = false

[site/fonts/*]
trim_trailing_whitespace = false

[*.{pbxproj,plist,entitlements,xcprivacy}]
indent_style = tab

[*.xcscheme]
indent_size = 3
